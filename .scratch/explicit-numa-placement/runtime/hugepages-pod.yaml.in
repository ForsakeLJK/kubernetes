apiVersion: v1
kind: Pod
metadata:
  name: __NAME__
spec:
  nodeName: __NODE__
  numaNode: __NUMA__
  restartPolicy: Never
  containers:
  - name: hugepages
    image: busybox:1.36
    command: ["sh", "-c", "sleep 3600"]
    volumeMounts:
    - name: pages
      mountPath: /hugepages
    resources:
      requests: {cpu: "1", memory: 128Mi, hugepages-2Mi: 2Mi}
      limits: {cpu: "1", memory: 128Mi, hugepages-2Mi: 2Mi}
  volumes:
  - name: pages
    emptyDir:
      medium: HugePages-2Mi
